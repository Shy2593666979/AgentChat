__pycache__/

.idea/

.vscode/

chat.html

.env

chroma_db/
memory_db/
vector_db/

node_modules/

# Local backend credentials; the checked-in config.yaml remains a template.
src/backend/agentchat/config.local*.yaml
src/backend/data/uploads/
.venv*/
*.db
*.db-shm
*.db-wal
.runtime/
src/backend/logs/
src/frontend/public/ui-detail-review/
docs/design-preview/

# 构建产物与增量缓存（每次构建都会变，不应进入版本库）
*.tsbuildinfo
src/frontend/dist/
src/backend/*.log

# unplugin 自动生成的类型声明，dev 会话按访问页面覆盖式重写
src/frontend/auto-imports.d.ts
src/frontend/components.d.ts

# uv 本地缓存（目录内自带 .gitignore，但目录本身仍会出现在 status 和 IDE 里）
.uv-cache/

# 后端运行时临时目录：TEMP 不可用时 tempfile 会把上传/解析临时文件落到工作目录
src/backend/tmp*/

# Python 测试、覆盖率与打包产物
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# tiktoken 词表缓存，运行后自动生成
data-gym-cache/
